{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Haven Walls",
  "version": "0.1.0",
  "identifier": "com.havenwalls.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Haven Walls",
        "width": 1150,
        "height": 750,
        "minWidth": 840,
        "minHeight": 600,
        "backgroundColor": "#F4F7FA",
        "decorations": false,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
